# Copy to .env.synology. Keep the real file private and out of Git.
# Generate two DIFFERENT random 64-character hexadecimal passwords.
POSTGRES_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_APP_PASSWORD
APP_IMAGE_TAG=local
LOCAL_APP_PORT=3001
SHOPIFY_API_KEY=REPLACE_WITH_EXISTING_APP_KEY
SHOPIFY_API_SECRET=REPLACE_WITH_EXISTING_APP_SECRET
# Use the current HTTPS test origin for staging; change both at cutover.
SHOPIFY_APP_URL=https://portal.crafted.gg
PORTAL_URL=https://portal.crafted.gg
SHOPIFY_SHOP=REPLACE_WITH_ALLOWED_SHOP.myshopify.com
SHOP_CURRENCY=USD
SUPABASE_URL=https://REPLACE_WITH_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_EXISTING_PUBLISHABLE_KEY
PORTAL_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Only needed when enabling the public tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
