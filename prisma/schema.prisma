// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  active
  inactive
}

enum TransactionType {
  sale
  refund
}

enum AffiliateType {
  organization
  creator
}

enum ApprovalStatus {
  pending
  approved
  rejected
  suspended
}

enum CommissionKind {
  percentage
  fixed_item
}

model AffiliateAccount {
  id               String         @id @default(uuid()) @db.Uuid
  type             AffiliateType
  firstName        String
  lastName         String
  email            String         @unique
  displayName      String
  organizationRole String?
  paypalEmail      String
  authSubject      String?        @unique
  verifiedAt       DateTime?      @db.Timestamptz(3)
  status           ApprovalStatus @default(pending)
  organizationId   String?        @unique @db.Uuid
  organization     Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reviewedAt       DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
}

model CommissionProgram {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  versions  ProgramVersion[]
}

model ProgramVersion {
  id           String                  @id @default(uuid()) @db.Uuid
  programId    String                  @db.Uuid
  program      CommissionProgram       @relation(fields: [programId], references: [id], onDelete: Restrict)
  label        String
  kind         CommissionKind
  rateBps      Int                     @default(0)
  fixedMinor   BigInt?
  currency     String                  @db.Char(3)
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  assignments  ProductAssignment[]
  transactions CommissionTransaction[]
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)
}

model WebhookDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  shop          String
  topic         String
  eventId       String
  resourceGid   String
  receivedAt    DateTime  @default(now()) @db.Timestamptz(3)
  processedAt   DateTime? @db.Timestamptz(3)
  attempts      Int       @default(0)
  error         String?
  claimedAt     DateTime? @db.Timestamptz(3)
  claimToken    String?   @db.Uuid
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([shop, topic, eventId])
}

model Organization {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String
  type         AffiliateType           @default(organization)
  account      AffiliateAccount?
  slug         String                  @unique
  status       OrganizationStatus      @default(active)
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  rates        CommissionRate[]
  assignments  ProductAssignment[]
  transactions CommissionTransaction[]
  lines        OrderLine[]
  payments     CommissionPayment[]
}

model CommissionRate {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rateBps        Int
  effectiveFrom  DateTime                @db.Timestamptz(3)
  effectiveTo    DateTime?               @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  transactions   CommissionTransaction[]

  @@unique([organizationId, effectiveFrom])
}

model ProductAssignment {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @db.Uuid
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productGid       String
  variantGid       String?
  displayTitle     String
  programVersionId String?                 @db.Uuid
  programVersion   ProgramVersion?         @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  effectiveFrom    DateTime                @db.Timestamptz(3)
  effectiveTo      DateTime?               @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  transactions     CommissionTransaction[]

  @@index([productGid, variantGid, effectiveFrom])
}

model Order {
  id              String                  @id @default(uuid()) @db.Uuid
  shopifyOrderGid String                  @unique
  displayName     String
  occurredAt      DateTime                @db.Timestamptz(3)
  currency        String                  @db.Char(3)
  importedAt      DateTime                @default(now()) @db.Timestamptz(3)
  lines           OrderLine[]
  transactions    CommissionTransaction[]
}

model OrderLine {
  id             String                  @id @default(uuid()) @db.Uuid
  orderId        String                  @db.Uuid
  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lineGid        String                  @unique
  productGid     String?
  variantGid     String?
  sku            String?
  title          String
  quantity       Int
  grossMinor     BigInt
  discountMinor  BigInt
  netMinor       BigInt
  currency       String                  @db.Char(3)
  organizationId String?                 @db.Uuid
  organization   Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  transactions   CommissionTransaction[]
}

model CommissionTransaction {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId            String                  @db.Uuid
  order              Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId        String                  @db.Uuid
  orderLine          OrderLine               @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  rateId             String?                 @db.Uuid
  rate               CommissionRate?         @relation(fields: [rateId], references: [id], onDelete: Restrict)
  programVersionId   String?                 @db.Uuid
  programVersion     ProgramVersion?         @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  kind               CommissionKind          @default(percentage)
  fixedMinor         BigInt?
  refundedQuantity   Int                     @default(0)
  assignmentId       String                  @db.Uuid
  assignment         ProductAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  type               TransactionType
  sourceKey          String                  @unique
  baseMinor          BigInt
  rateBps            Int
  commissionMinor    BigInt
  currency           String                  @db.Char(3)
  sourceRef          String
  reversalOfId       String?                 @db.Uuid
  reversalOf         CommissionTransaction?  @relation("Reversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals          CommissionTransaction[] @relation("Reversals")
  paymentAllocations PaymentAllocation[]
  occurredAt         DateTime                @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)

  @@index([organizationId, occurredAt])
  @@index([reversalOfId])
}

// Payments record transfers already made outside the app. Financial history is
// append-only; a void records an entry mistake without undoing a transfer.
model CommissionPayment {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  amountMinor    BigInt
  currency       String              @db.Char(3)
  paidAt         DateTime            @db.Timestamptz(3)
  method         String
  reference      String
  referenceKey   String              @unique
  idempotencyKey String              @unique @db.Uuid
  payeeEmail     String
  recordedBy     String
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  allocations    PaymentAllocation[]
  void           PaymentVoid?

  @@index([organizationId, paidAt])
}

model PaymentAllocation {
  id            String                @id @default(uuid()) @db.Uuid
  paymentId     String                @db.Uuid
  payment       CommissionPayment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  transactionId String                @db.Uuid
  transaction   CommissionTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  amountMinor   BigInt

  @@unique([paymentId, transactionId])
  @@index([transactionId])
}

model PaymentVoid {
  id         String            @id @default(uuid()) @db.Uuid
  paymentId  String            @unique @db.Uuid
  payment    CommissionPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reason     String
  recordedBy String
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actor     String
  action    String
  entityId  String   @db.Uuid
  metadata  Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
