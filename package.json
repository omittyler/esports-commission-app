{
  "name": "esports-commission-app",
  "private": true,
  "scripts": {
    "build": "npm run cloudflare:build",
    "dev": "npm run cloudflare:dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "npm run cloudflare:preview",
    "docker-start": "npm run prisma -- migrate deploy && npm run start",
    "setup": "npm run cloudflare:generate && wrangler d1 migrations apply crafted-commissions --local",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "npm run cloudflare:generate && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "cloudflare:generate": "prisma generate && node scripts/generate-d1.mjs && prisma generate --schema cloudflare/prisma/schema.prisma",
    "cloudflare:build": "npm run cloudflare:generate && react-router build --config vite.cloudflare.config.ts",
    "cloudflare:dev": "react-router dev --config vite.cloudflare.config.ts",
    "cloudflare:preview": "vite preview --config vite.cloudflare.config.ts",
    "cloudflare:deploy": "npm run cloudflare:build && wrangler deploy",
    "cloudflare:export": "node --env-file=.env --import tsx scripts/export-d1.ts",
    "cloudflare:seed": "tsx scripts/seed-d1.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "tsx scripts/dev-db.ts",
    "worker": "node --env-file=.env --import tsx scripts/process-webhooks.ts",
    "worker:production": "node --import tsx scripts/process-webhooks.ts",
    "refresh:orders": "node --env-file=.env --import tsx scripts/refresh-orders.ts",
    "refresh:orders:production": "node --import tsx scripts/refresh-orders.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "tsx": "^4.23.15",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/cli": "^4.9.3",
    "@shopify/polaris-types": "1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.4",
    "wrangler": "^4.166.0"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
